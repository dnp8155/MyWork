{
  "name": "ProjectMember",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Team member name"
    },
    "email": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "manager",
        "developer",
        "designer",
        "other"
      ],
      "default": "developer"
    },
    "salary_type": {
      "type": "string",
      "enum": [
        "monthly",
        "per_project",
        "none"
      ],
      "default": "monthly",
      "description": "Monthly salary or one-time project payout"
    },
    "salary_amount": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "invited",
        "active",
        "removed"
      ],
      "default": "invited"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}