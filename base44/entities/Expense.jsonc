{
  "name": "Expense",
  "type": "object",
  "properties": {
    "expense_number": {
      "type": "string",
      "description": "Auto-generated e.g. EXP-2026-0001"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "category": {
      "type": "string",
      "enum": [
        "domain",
        "hosting",
        "software",
        "api",
        "base44",
        "server",
        "development",
        "marketing",
        "employee_salary",
        "other"
      ],
      "default": "other"
    },
    "subcategory": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "vendor": {
      "type": "string"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "bank_transfer",
        "upi",
        "card",
        "other"
      ],
      "default": "bank_transfer"
    },
    "description": {
      "type": "string"
    },
    "receipt_url": {
      "type": "string"
    },
    "recurring": {
      "type": "boolean",
      "default": false
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "domain",
        "hosting"
      ],
      "default": "manual"
    },
    "linked_domain_id": {
      "type": "string"
    },
    "linked_hosting_id": {
      "type": "string"
    }
  },
  "required": [
    "amount",
    "date",
    "category"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}