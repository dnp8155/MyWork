{
  "name": "RecurringPaymentSchedule",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "paid_amount": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "due",
        "paid",
        "partially_paid",
        "overdue"
      ],
      "default": "upcoming"
    },
    "payment_id": {
      "type": "string",
      "description": "Linked payment when paid"
    },
    "installment_number": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "project_id",
    "due_date",
    "amount"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}