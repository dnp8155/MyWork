{
  "name": "Base44Account",
  "type": "object",
  "properties": {
    "account_name": {
      "type": "string"
    },
    "account_email": {
      "type": "string"
    },
    "account_identifier": {
      "type": "string",
      "description": "Login / workspace identifier (not password)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "cancelled"
      ],
      "default": "active"
    },
    "plan": {
      "type": "string"
    },
    "subscription_cost": {
      "type": "number",
      "default": 0
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly",
        "custom"
      ],
      "default": "monthly"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "renewal_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "account_owner": {
      "type": "string"
    }
  },
  "required": [
    "account_name"
  ]
}