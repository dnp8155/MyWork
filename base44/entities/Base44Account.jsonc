{
  "name": "Base44Account",
  "type": "object",
  "properties": {
    "account_name": {
      "type": "string"
    },
    "account_email": {
      "type": "string"
    },
    "password": {
      "type": "string",
      "description": "Account password"
    }
  },
  "required": [
    "account_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}