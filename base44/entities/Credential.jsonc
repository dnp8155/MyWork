{
  "name": "Credential",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "What this login is for, e.g. GoDaddy Account"
    },
    "category": {
      "type": "string",
      "enum": [
        "domain",
        "hosting",
        "google",
        "email",
        "server",
        "social",
        "payment",
        "other"
      ],
      "default": "other"
    },
    "username": {
      "type": "string",
      "description": "Email or username used to log in"
    },
    "password": {
      "type": "string"
    },
    "login_url": {
      "type": "string",
      "description": "Login page URL"
    },
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}